{
  "expo": {
    "name": "ALAYAA",
    "slug": "alayaa-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "alayaa",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.elaiyanila.alayaa" },
    "android": {
      "package": "com.elaiyanila.alayaa",
      "adaptiveIcon": { "backgroundColor": "#0F766E" },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": ["expo-image-picker"]
  }
}
